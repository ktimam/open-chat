{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "OpenChat Fork · Local Test",
    "build": {
        "beforeBuildCommand": "node ../scripts/build-unofficial-local-apk.mjs --frontend-only",
        "frontendDist": "../app/build"
    },
    "app": {
        "security": {
            "capabilities": [
                "default",
                {
                    "identifier": "local-app-handoff",
                    "description": "Explicitly approved private draft transport for the separate local test APK",
                    "local": true,
                    "windows": ["main"],
                    "permissions": ["oc:allow-local-app-handoff"]
                },
                {
                    "identifier": "local-app-setup",
                    "description": "Explicit app connection for the separate local test APK; no chat data",
                    "local": true,
                    "windows": ["main"],
                    "permissions": ["oc:allow-local-app-setup"]
                }
            ]
        }
    },
    "plugins": { "deep-link": { "mobile": [] } }
}

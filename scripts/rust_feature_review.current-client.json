      "id": "plugin-module-and-schema-closure",
      "disposition": "no-additional-external-owner-edge",
      "explanation": "Reviewed native module dispatch, commands, error schema and model nested structs. Dedicated protocols use only listed serde/JSON/reqwest/hex/SHA owner edges plus standard-library state. Model manager uses the listed stream, URL, JSON, hash, Tauri, Tokio and sysinfo roots; optional inference adds only llama-cpp-2/minijinja/minijinja-contrib. There are no separate dev dependencies for the embedded tests. Shared production edges are not downgraded to test context.",
      "profiles": [
        "android-arm64-local-webgpu",
        "android-x86_64-local-webgpu",
        "linux-default-tests",
        "linux-inference-check",
        "linux-inference-store-check",
        "windows-default-tests",
        "windows-inference-check",
        "windows-inference-store-check"
      ],
